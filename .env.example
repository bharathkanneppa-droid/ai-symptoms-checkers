# ------------------------------------------------------------------
# MediAssist AI - environment variables (copy to .env and fill in)
# ------------------------------------------------------------------

# Flask / security
SECRET_KEY=change-me-to-a-long-random-string
FLASK_DEBUG=false

# Database: leave empty for local SQLite, or set a PostgreSQL URL in production
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# AI (Google Gemini): set to enable the real AI chatbot.
# Get a free key at https://aistudio.google.com/apikey (starts with AQ. in 2026)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Auth
REMEMBER_DAYS=14
# When true, new accounts must verify their email before logging in.
EMAIL_VERIFICATION_REQUIRED=false

# SMTP (used for verification + password reset emails).
# When unset, emails are printed to the console instead of being sent.
# For Gmail: enable 2-Step Verification, then create an App Password at
# https://myaccount.google.com/apppasswords and use it as MAIL_PASSWORD.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=no-reply@medassist.local
